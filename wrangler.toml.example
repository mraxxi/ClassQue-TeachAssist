# Cloudflare Pages / Workers Wrangler Configuration
# For ClassQue-TeachAssist

name = "classque-teachassist"
compatibility_date = "2026-04-01"
compatibility_flags = ["nodejs_compat"]
pages_build_output_dir = "./dist"

# ==========================================
# 1. Cloudflare D1 Database Binding (Edge SQLite)
# ==========================================
[[d1_databases]]
binding = "DB"
database_name = "classque_db"
database_id = "YOUR_D1_DATABASE_ID_HERE"
migrations_dir = "./migrations"

# ==========================================
# 2. Cloudflare KV Namespace (Optional / Presets & Auth)
# ==========================================
# [[kv_namespaces]]
# binding = "KV_CACHE"
# id = "YOUR_KV_NAMESPACE_ID_HERE"

# ==========================================
# 3. Environment Variables (Edge Functions)
# ==========================================
[vars]
ENVIRONMENT = "production"
APP_NAME = "ClassQue-TeachAssist"

# Cloudflare Access login (multi-user by email). `wrangler pages deploy` REPLACES the dashboard variables with this
# [vars] block, so uncomment and fill the three CF_ACCESS/LEGACY lines below (in your untracked wrangler.toml) when you deploy
# with Wrangler, or deploy from a folder without wrangler.toml. See docs/CLOUDFLARE_SETUP.md "Deploying safely".
# Otherwise set them in the Pages dashboard for production;
# see docs/CLOUDFLARE_SETUP.md section 7. They are the only protection of the API.
# CF_ACCESS_TEAM_DOMAIN = "yourteam.cloudflareaccess.com"
# CF_ACCESS_AUD = "YOUR_ACCESS_APPLICATION_AUD_TAG"
# Local dev only (use .dev.vars; ignored when CF_ACCESS_AUD is set):
# DEV_USER_EMAIL = "you@example.com"
# Email of whoever owned the data saved before logins existed (the placeholder teacher 'teacher-1').
# Set it BEFORE that person's first login so they claim it.
# LEGACY_OWNER_EMAIL = "you@example.com"

# ==========================================
# 4. Staging = the Pages *preview* environment (deploy with --branch staging)
# ==========================================
# Pages takes ALL bindings from this file on every deploy, and an environment block does not inherit
# d1_databases or vars. Without this block preview deploys use the production database.
[env.preview]
[[env.preview.d1_databases]]
binding = "DB"
database_name = "classque_db_staging"
database_id = "YOUR_STAGING_D1_DATABASE_ID_HERE"
migrations_dir = "./migrations"

[env.preview.vars]
ENVIRONMENT = "staging"
APP_NAME = "ClassQue-TeachAssist (staging)"
# Staging has its own Access application (own AUD); fill these in your untracked wrangler.toml.
# CF_ACCESS_TEAM_DOMAIN = "yourteam.cloudflareaccess.com"
# CF_ACCESS_AUD = "YOUR_STAGING_ACCESS_APPLICATION_AUD_TAG"
# LEGACY_OWNER_EMAIL = "you@example.com"
